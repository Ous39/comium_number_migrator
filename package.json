  "description": "Drop-in React Native module that migrates saved Gambian contacts from 7-digit to 9-digit numbers (PURA transition).",
  "main": "src/modules/gnm/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
